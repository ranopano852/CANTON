<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>粵語網路課堂 - 課程簡介</title>
    <style>
        :root {
            --primary-color: #333;
            --secondary-color: #666;
            --bg-color: rgb(249, 233, 210); /* 整個頁面統一使用指定RGB顏色 */
            --container-width: 600px;
        }

        body {
            font-family: "Microsoft JhengHei", "PingFang TC", sans-serif;
            margin: 0;
            padding: 0; /* 移除 body padding，讓 top-bar 頂到最上方 */
            background-color: var(--bg-color);
            color: var(--primary-color);
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            box-sizing: border-box;
            overflow: hidden; /* 確保絕不出現 scroll down */
        }

        /* top-bar 樣式（「粵語網路課堂」在左上角，pgMenu 在右側同一條 BAR） */
        .top-bar {
            width: 100%;
            max-width: var(--container-width);
            background-color: rgb(249, 233, 210);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
            border-bottom: 1px solid #e5d9c0;
            position: relative;
            z-index: 10;
        }

        .top-bar-left {
            flex: 1;
        }

        .title {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            margin: 0;
            text-align: left; /* 嚴格置於 BAR 左上角 */
        }

        .top-bar-right {
            flex-shrink: 0;
        }

        #pgMenu {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 15px;
        }

        #pgMenu a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        #pgMenu a:hover {
            color: #c0392b;
        }

        .container {
            width: 100%;
            max-width: var(--container-width);
            position: relative;
            margin-top: 0; /* 緊接 top-bar，下方無多餘間距 */
        }

        /* 保留 pgJumbotron 結構，方便你後續連接原有框架的 CSS */
        .pgJumbotron {
            width: 100%;
            padding: 0;
            margin: 0;
        }

        header {
            width: 100%;
            margin-bottom: 5px;
        }

        .motto {
            font-size: 14px;
            color: var(--secondary-color);
            margin-top: 5px;
            text-align: center; /* 已改為置中 */
        }

        .content-section {
            margin-top: 5px; /* 保持 MOTTO 與「課程簡介」的緊湊距離 */
            padding-top: 5px;
            border-top: 1px solid #eee;
        }

        h2 {
            font-size: 20px;
            margin-bottom: 10px;
            color: #34495e;
            text-align: center;
        }

        .description {
            font-size: 15px;
            text-align: center; /* 已改為置中 */
        }

        .levels {
            margin-top: 10px;
            font-size: 14px;
            text-align: center; /* 已改為置中 */
        }

        .level-item {
            margin-bottom: 5px;
        }

        .footer-note {
            margin-top: 15px;
            font-size: 13px;
            color: #7f8c8d;
            font-style: italic;
            text-align: center; /* 已改為置中 */
        }

        /* 響應式調整，確保任何高度下都不會出現 scroll */
        @media (max-height: 600px) {
            .top-bar { padding: 10px 15px; }
            .title { font-size: 22px; }
            h2 { font-size: 18px; }
            .motto, .description, .levels { font-size: 13px; }
            .content-section { margin-top: 3px; padding-top: 3px; }
        }

        @media (max-height: 500px) {
            .title { font-size: 20px; }
            .motto { font-size: 12.5px; }
            #pgMenu { font-size: 13px; gap: 15px; }
        }
    </style>
</head>
